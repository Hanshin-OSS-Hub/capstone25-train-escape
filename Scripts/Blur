// BlurRenderFeature.cs

using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.Rendering.Universal;

public class BlurRenderFeature : ScriptableRendererFeature
{
    [System.Serializable]
    public class BlurSettings
    {
        public RenderPassEvent renderPassEvent = RenderPassEvent.AfterRenderingTransparents;
        [Range(0, 10)] public float blurAmount = 0f;
        public Shader blurShader;
    }

    public BlurSettings settings = new BlurSettings();

    class BlurPass : ScriptableRenderPass
    {
        private Material material;
        private float blurAmount;
        private RenderTargetIdentifier source;
        private RenderTargetHandle tempTexture;

        public BlurPass(Shader shader)
        {
            material = CoreUtils.CreateEngineMaterial(shader);
            tempTexture.Init("_TempBlurTexture");
        }

        public void SetBlur(float amount)
        {
            blurAmount = amount;
        }

        public void Setup(RenderTargetIdentifier src)
        {
            source = src;
        }

        public override void Execute(ScriptableRenderContext context, ref RenderingData renderingData)
        {
            if (material == null) return;

            CommandBuffer cmd = CommandBufferPool.Get("Gaussian Blur");

            material.SetFloat("_BlurSize", blurAmount);

            RenderTextureDescriptor descriptor = renderingData.cameraData.cameraTargetDescriptor;
            descriptor.depthBufferBits = 0;

            // 1) 수평 블러
            cmd.GetTemporaryRT(tempTexture.id, descriptor);
            cmd.Blit(source, tempTexture.Identifier(), material, 0);

            // 2) 수직 블러
            cmd.Blit(tempTexture.Identifier(), source, material, 1);

            context.ExecuteCommandBuffer(cmd);
            CommandBufferPool.Release(cmd);
        }
    }

    BlurPass blurPass;

    public override void Create()
    {
        if (settings.blurShader == null)
        {
            Debug.LogError("Blur Shader not assigned in BlurRenderFeature.");
            return;
        }

        blurPass = new BlurPass(settings.blurShader);
        blurPass.renderPassEvent = settings.renderPassEvent;
    }

    public override void AddRenderPasses(ScriptableRenderer renderer, ref RenderingData renderingData)
    {
        if (blurPass == null) return;

        var src = renderer.cameraColorTarget;
        blurPass.Setup(src);

        // Shader.GlobalFloat 값을 읽어와 반영
        float globalBlur = Shader.GetGlobalFloat("_GlobalScreenBlur");
        blurPass.SetBlur(globalBlur);

        renderer.EnqueuePass(blurPass);
    }
}



// GaussianBlur.shader (Assets/Shaders/GaussianBlur.shader)

Shader "Hidden/Custom/GaussianBlur"
{
    Properties
    {
        _MainTex ("Texture", 2D) = "white" {}
        _BlurSize ("Blur Size", Float) = 1.0
    }
    SubShader
    {
        Tags { "RenderType"="Opaque" }
        Pass
        {
            Name "HorizontalBlur"
            ZTest Always Cull Off ZWrite Off

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            TEXTURE2D(_MainTex);
            SAMPLER(sampler_MainTex);

            float _BlurSize;

            struct Attributes { float4 positionOS : POSITION; float2 uv : TEXCOORD0; };
            struct Varyings { float4 positionHCS : SV_POSITION; float2 uv : TEXCOORD0; };

            Varyings vert (Attributes IN)
            {
                Varyings o;
                o.positionHCS = TransformObjectToHClip(IN.positionOS.xyz);
                o.uv = IN.uv;
                return o;
            }

            float4 frag (Varyings IN) : SV_Target
            {
                float2 uv = IN.uv;
                float2 offset = float2(_BlurSize / _ScreenParams.x, 0);

                float4 col = 0;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv - offset * 2) * 0.05;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv - offset) * 0.25;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv) * 0.4;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv + offset) * 0.25;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv + offset * 2) * 0.05;

                return col;
            }
            ENDHLSL
        }

        Pass
        {
            Name "VerticalBlur"
            ZTest Always Cull Off ZWrite Off

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            TEXTURE2D(_MainTex);
            SAMPLER(sampler_MainTex);

            float _BlurSize;

            struct Attributes { float4 positionOS : POSITION; float2 uv : TEXCOORD0; };
            struct Varyings { float4 positionHCS : SV_POSITION; float2 uv : TEXCOORD0; };

            Varyings vert (Attributes IN)
            {
                Varyings o;
                o.positionHCS = TransformObjectToHClip(IN.positionOS.xyz);
                o.uv = IN.uv;
                return o;
            }

            float4 frag (Varyings IN) : SV_Target
            {
                float2 uv = IN.uv;
                float2 offset = float2(0, _BlurSize / _ScreenParams.y);

                float4 col = 0;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv - offset * 2) * 0.05;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv - offset) * 0.25;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv) * 0.4;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv + offset) * 0.25;
                col += SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, uv + offset * 2) * 0.05;

                return col;
            }
            ENDHLSL
        }
    }
}

// CameraBlurController 에서 연동 (쓰고 있던 Controller에서 Gaussian Blur 값만 보내면 됨)
private void UpdateScreenBlur(float value)
{
    Shader.SetGlobalFloat("_GlobalScreenBlur", value);
}

// 적용 방법
1) Project → Renderer → Renderer Data 열기
Renderer Features → Add Feature → BlurRenderFeature 추가

2) BlurRenderFeature에
Blur Shader → 위에서 만든 GaussianBlur 넣기

3) CameraBlurController에서
UpdateScreenBlur(0~5); 로 블러 강도 제어

+ 
1. Main Camera
CameraBlurController.cs 붙임
게임에서 상황에 따라 UpdateScreenBlur(x) 호출

2. Renderer Data(URP Forward Renderer Asset)
BlurRenderFeature 추가
Blur Shader 슬롯에 GaussianBlur.shader 넣기

3. 실행하면
CameraBlurController가 blurAmount를 Shader 전역 값으로 보냄 →
BlurRenderFeature가 그 값을 읽음 →
GaussianBlur.shader로 화면을 흐리게 그림.

// 화면 엄청 뭉개기
UpdateScreenBlur(6f);

// 몽환적인 약한 블러
UpdateScreenBlur(1.2f);

// 부드럽게 없애기 (코루틴으로 가능)
UpdateScreenBlur(0f);






1. Project → Assets → Create → Shader → Standard Surface Shader
이름: SimpleGaussianBlur.shader
내용은 Shader 코드 그대로 붙이기
Hidden/Custom 제거 → Material에서 선택 가능하도록

2. Material 생성
Project → 우클릭 → Create → Material
Shader → Custom → SimpleGaussianBlur 선택
이름: BlurMaterial

3. 스크립트 만들기
Project → Assets → Create → C# Script
이름: SimpleScreenBlur.cs
SimpleScreenBlur.cs 코드 그대로 붙이기

4. Main Camera에 컴포넌트 추가
Add Component → SimpleScreenBlur
Inspector → blurMaterial에 아까 만든 BlurMaterial 연결

5. Inspector에서 blurAmount 조절
0 → 블러 없음
5 → 최대 블러
플레이 모드에서도 실시간 조절 가능

// GaussianBlur.shader  -> 블러 강도를 _Size 값으로 조절
Shader "Custom/SimpleGaussianBlur"
{
    Properties
    {
        _MainTex ("Texture", 2D) = "white" {}
        _Size ("Blur Size", Range(0, 5)) = 2
    }
    SubShader
    {
        Tags { "RenderType"="Opaque" }
        Pass
        {
            ZTest Always Cull Off ZWrite Off

            CGPROGRAM
            #pragma vertex vert_img
            #pragma fragment frag

            #include "UnityCG.cginc"

            sampler2D _MainTex;
            float _Size;

            fixed4 frag(v2f_img i) : SV_Target
            {
                float2 uv = i.uv;
                fixed4 col = fixed4(0,0,0,0);

                float offset = _Size / 512.0; // 화면 비율에 따라 조정
                col += tex2D(_MainTex, uv + float2(-offset, -offset)) * 0.0625;
                col += tex2D(_MainTex, uv + float2(0, -offset)) * 0.125;
                col += tex2D(_MainTex, uv + float2(offset, -offset)) * 0.0625;

                col += tex2D(_MainTex, uv + float2(-offset, 0)) * 0.125;
                col += tex2D(_MainTex, uv) * 0.25;
                col += tex2D(_MainTex, uv + float2(offset, 0)) * 0.125;

                col += tex2D(_MainTex, uv + float2(-offset, offset)) * 0.0625;
                col += tex2D(_MainTex, uv + float2(0, offset)) * 0.125;
                col += tex2D(_MainTex, uv + float2(offset, offset)) * 0.0625;

                return col;
            }
            ENDCG
        }
    }
}

// SimpleScreenBlur.cs
using UnityEngine;

[ExecuteAlways]
[RequireComponent(typeof(Camera))]
public class SimpleScreenBlur : MonoBehaviour
{
    public Material blurMaterial; // GaussianBlur Material 연결
    [Range(0f, 5f)]
    public float blurAmount = 2f;

    private void OnRenderImage(RenderTexture src, RenderTexture dest)
    {
        if (blurMaterial != null)
        {
            blurMaterial.SetFloat("_Size", blurAmount);
            Graphics.Blit(src, dest, blurMaterial);
        }
        else
        {
            Graphics.Blit(src, dest);
        }
    }
}
