// ① Project → Create → Rendering → URP Render Feature → FullScreen Pass Renderer Feature
이름: BlurRendererFeature
그러면 다음 파일이 자동 생성: BlurRendererFeature.cs, BlurRenderPass.cs (혹은 비슷한 이름)

// BlurRendererFeature.cs 코드
using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.Rendering.Universal;

public class BlurRendererFeature : ScriptableRendererFeature
{
    [System.Serializable]
    public class BlurSettings
    {
        public Material blurMaterial;
        public int blurPassIndex = 0;
    }

    public BlurSettings settings = new BlurSettings();
    BlurRenderPass pass;

    public override void Create()
    {
        pass = new BlurRenderPass(settings.blurMaterial, settings.blurPassIndex);
        pass.renderPassEvent = RenderPassEvent.AfterRenderingTransparents;
    }

    public override void AddRenderPasses(ScriptableRenderer renderer, ref RenderingData renderingData)
    {
        pass.Setup(renderer.cameraColorTargetHandle);
        renderer.EnqueuePass(pass);
    }
}

public class BlurRenderPass : ScriptableRenderPass
{
    Material blurMaterial;
    int passIndex;

    RenderTargetIdentifier source;

    public BlurRenderPass(Material material, int index)
    {
        blurMaterial = material;
        passIndex = index;
    }

    public void Setup(RenderTargetHandle sourceHandle)
    {
        source = sourceHandle;
    }

    public override void Execute(ScriptableRenderContext context, ref RenderingData renderingData)
    {
        if (blurMaterial == null) return;

        CommandBuffer cmd = CommandBufferPool.Get("Custom Blur");

        RenderTextureDescriptor desc = renderingData.cameraData.cameraTargetDescriptor;
        desc.depthBufferBits = 0;

        int temp = Shader.PropertyToID("_TempRT");
        cmd.GetTemporaryRT(temp, desc);

        // Pass 0 블러 적용
        cmd.Blit(source, temp, blurMaterial, passIndex);

        // 원본에 다시 적용
        cmd.Blit(temp, source);

        cmd.ReleaseTemporaryRT(temp);
        context.ExecuteCommandBuffer(cmd);
        CommandBufferPool.Release(cmd);
    }
}


// Blur Shader 코드
Create → Shader → Unlit Shader
이름: Blur.shader
아래 코드로 전체 바꾸기 

Shader "Custom/Blur"
{
    Properties
    {
        _MainTex("Texture", 2D) = "white" {}
        _BlurSize("Blur Size", Float) = 1.0
    }
    SubShader
    {
        Tags { "RenderType"="Opaque" }

        Pass
        {
            Name "SimpleBlur"
            ZWrite Off
            Cull Off

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "UnityCG.cginc"

            sampler2D _MainTex;
            float4 _MainTex_TexelSize;
            float _BlurSize;

            struct appdata
            {
                float4 vertex : POSITION;
                float2 uv : TEXCOORD0;
            };

            struct v2f
            {
                float2 uv : TEXCOORD0;
                float4 vertex : SV_POSITION;
            };

            v2f vert (appdata v)
            {
                v2f o;
                o.vertex = UnityObjectToClipPos(v.vertex);
                o.uv = v.uv;
                return o;
            }

            float4 frag (v2f i) : SV_Target
            {
                float2 uv = i.uv;
                float2 offset = _BlurSize * _MainTex_TexelSize.xy;

                float4 col = float4(0,0,0,0);

                col += tex2D(_MainTex, uv + offset * float2(-1,-1));
                col += tex2D(_MainTex, uv + offset * float2(-1, 1));
                col += tex2D(_MainTex, uv + offset * float2( 1,-1));
                col += tex2D(_MainTex, uv + offset * float2( 1, 1));

                col *= 0.25;

                return col;
            }
            ENDHLSL
        }
    }
}

// Blur Material 만들기
Project 창에서: Create → Material → BlurMat 그리고 Shader를 Custom → Blur로 선택

// Renderer Feature에 Blur 연결
1️⃣ Project → URP-HighFidelityRenderer 또는 UniversalRendererData 열기
2️⃣ Bottom에 Add Render Feature → BlurRendererFeature 추가
3️⃣ Blur Material → 방금 만든 BlurMat 연결
4️⃣ Blur Size 조절
0 = 없음
1~2 = 약한 블러
4~10 = 강한 블러(시각장애 표현)

// 블러 On/Off 스크립트 (가장 쉬움)
using UnityEngine;
using UnityEngine.Rendering.Universal;

public class BlurToggle : MonoBehaviour
{
    public ScriptableRendererFeature blurFeature;

    void Update()
    {
        if (Input.GetKeyDown(KeyCode.B))
        {
            blurFeature.SetActive(!blurFeature.isActive);
        }
    }
}
